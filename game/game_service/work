 private async joinGameRoom(roomId: string, userId: number): Promise<number> {
    await this.redisService.addPlayerToRoom(userId.toString(), roomId);
    return await this.redisService.countPlayersInRoom(roomId);
  }

  private async leaveGameRoom(roomId: string, userId: number): Promise<void> {
    await this.redisService.removePlayerFromRoom(userId.toString(), roomId);
    const count = await this.redisService.countPlayersInRoom(roomId);
    if (count === 0) {
      await this.redisService.removeActiveRoom(roomId);
      await this.redisService.removeInactiveRoom(roomId);
    }
  }

  // roomIds + authorized users -> next Redis
  private readonly autorizedPlayers = new Map<string, Set<number>>();
  registerRoom(roomId: string, userIds: number[]): void {
    this.autorizedPlayers.set(roomId, new Set(userIds));
  }

  isPlayerInRoom(userId: number, roomId: string): boolean {
    return this.autorizedPlayers.get(roomId)?.has(userId) ?? false;
  }

async onGodotConnected(
    client: WebSocket,
    userId: number,
    roomId: string,
  ): Promise<void> {
    const roomSize = await this.joinGameRoom(roomId, userId);
    console.log(`Size = ${roomSize}, RoomId = ${roomId}`);

    if (!this.playerService.getPlayer(userId)) {
      this.playerService.initPlayer(userId);
    }

    const playerIds = await this.redisService.getPlayersFromRoom(roomId);
    const roomSet = new Set(playerIds.map(id => Number(id)));

    if (roomSize === FULL) {
      await this.redisService.removeInactiveRoom(roomId);
      await this.redisService.addActiveRoom(roomId);

      this.combatService.matchmake(roomSet);
      
      for (const uid of roomSet) {
        const opponentId = this.combatService.getOpponentId(uid);
        const enemy = opponentId ? this.playerService.getPlayer(opponentId) : undefined;
        if (!enemy) {
          console.log(`[GameService]: No opponent for ${uid} (room ${roomId}) - using player as placeholder`);
        }
        console.log('USER ID: ', uid);
        console.log('OPPONENT ID: ', opponentId);
        console.log('******************');
      }

      await this.startMapPhase(roomId, roomSet);
    }
  }

  async onGodotDisconnected(userId: number, roomId: string): Promise<void> {
    await this.leaveGameRoom(roomId, userId);
  }

